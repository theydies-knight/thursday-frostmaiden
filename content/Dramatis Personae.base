filters:
  and:
    - file.folder == "Dramatis Personae"
properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: Default
    groupBy:
      property: tags
      direction: ASC
    groupOrder:
      - - "#Party"
      - - "#Ally"
      - - "#Adversary"
      - - "#Neutral"
      - - "#Deity"
      - 
      - - "#Archdevil"
    order:
      - file.name
      - tags
      - status
      - affiliations
      - location
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 163
  - type: table
    name: Descriptive
    order:
      - file.name
      - description
    sort:
      - property: summary
        direction: ASC
