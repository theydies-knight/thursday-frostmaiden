filters:
  and:
    - file.folder == "Dramatis Personae"
properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: View
    groupBy:
      property: tags
      direction: ASC
    groupOrder:
      - - "#Party"
      - - "#Ally"
      - - "#Adversary"
      - - "#Deity"
    order:
      - file.name
      - tags
      - aliases
      - status
      - affiliations
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 163
