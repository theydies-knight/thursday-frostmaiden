properties:
  note.title:
    displayName: Title
  note.date:
    displayName: Date
views:
  - type: table
    name: View
    filters:
      and:
        - file.folder == "Adventure Log"
    order:
      - file.name
      - title
      - date
    sort:
      - property: date
        direction: DESC
      - property: title
        direction: DESC
